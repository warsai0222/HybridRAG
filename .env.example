# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hybridrag:hybridrag@localhost:5432/hybridrag

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Embedding model ──────────────────────────────────────────────────────────
# Downloads automatically from HuggingFace on first run (~1.3 GB)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# ── Classifier ───────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
# Number of similar examples to retrieve per classification
TOP_K_DENSE=5
TOP_K_SPARSE=5
TOP_K_FINAL=5

# ── RRF Fusion ───────────────────────────────────────────────────────────────
# Standard RRF constant (60 is the default from the original paper)
RRF_K=60

# ── Classification domain ────────────────────────────────────────────────────
# Labels for your domain — comma-separated, no spaces
# Default: customer support tickets
LABELS=billing,technical_support,returns_and_refunds,account_management,general_inquiry
